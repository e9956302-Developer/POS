PORT=4000
NODE_ENV=production
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Option A: Discrete MySQL credentials (Local or Cloud)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=mobile_pos
DB_SSL=false

# Option B: Cloud MySQL Connection URL (Aiven, PlanetScale, Railway, TiDB)
# DATABASE_URL=mysql://username:password@hostname:3306/mobile_pos

# Security Settings
ENFORCE_TOP_ADMIN_MFA=false
